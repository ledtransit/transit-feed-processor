# Postgres connection string for the database where the feed processor stores its state
DATABASE_URL=postgres://postgres:postgres@localhost:5432/transit_feed

# User-Agent sent with every outbound feed request. Must identify the operator
# (e.g. a contact URL or email); the placeholder below is rejected at startup.
USER_AGENT='transit-feed-processor (+https://example.com)'

# Optional: credentials for the DELFI GTFS-RT feed via Mobilithek. Without them
# that realtime source is skipped. The client certificate is read from
# cert/mobilithek.p12 (PKCS#12, relative to the working directory).
# MOBILITHEK_DELFI_GTFS_RT_SUBSCRIPTION_ID=
# MOBILITHEK_M2M_CERT_PASSWORD=
